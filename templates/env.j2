# ComposeFlux environment configuration
# Managed by Ansible - do not edit manually
{% macro env_line(name, value) %}
{% if value | string | length > 0 %}
{{ name }}={{ value }}
{% endif %}
{% endmacro %}
{{ env_line("GIT_REPO_URL", composeflux_git_repo_url) -}}
{{ env_line("STACK_PATH", composeflux_stack_path) -}}
{{ env_line("GIT_CLONE_PATH", composeflux_git_clone_path) -}}
{{ env_line("GIT_BRANCH", composeflux_git_branch) -}}
{{ env_line("GIT_INTERVAL", composeflux_git_interval) -}}
{{ env_line("GIT_DEPLOY_KEY_SECRET_REF", composeflux_git_deploy_key_secret_ref) -}}
{% if composeflux_deploy_key_src | length > 0 %}
{{ env_line("GIT_SSH_KEY_PATH", composeflux_git_ssh_key_path) -}}
{% endif %}
{{ env_line("SECRETS_PROVIDER", composeflux_secrets_provider) -}}
{{ env_line("BITWARDEN_ACCESS_TOKEN", composeflux_bitwarden_access_token) -}}
{{ env_line("BITWARDEN_ORGANIZATION_ID", composeflux_bitwarden_organization_id) -}}
{{ env_line("BITWARDEN_PROJECT_ID", composeflux_bitwarden_project_id) -}}
{{ env_line("INFISICAL_CLIENT_ID", composeflux_infisical_client_id) -}}
{{ env_line("INFISICAL_CLIENT_SECRET", composeflux_infisical_client_secret) -}}
{{ env_line("INFISICAL_ENVIRONMENT", composeflux_infisical_environment) -}}
{{ env_line("INFISICAL_PROJECT_ID", composeflux_infisical_project_id) -}}
{{ env_line("INFISICAL_SECRET_PATH", composeflux_infisical_secret_path) -}}
{{ env_line("IMAGE_UPDATE_SCHEDULE", composeflux_image_update_schedule) -}}
{% if composeflux_metrics_enabled %}
{{ env_line("METRICS_ADDR", ":9090") -}}
{% endif %}
{{ env_line("LOG_LEVEL", composeflux_log_level) -}}
{{ env_line("LOG_ADD_SOURCE", composeflux_log_add_source) -}}
{% for key, value in composeflux_extra_env.items() %}
{{ env_line(key, value) -}}
{% endfor %}
